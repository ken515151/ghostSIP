# GhostSIP bootstrap — copy to the REPO ROOT as `.env` and fill in:
#     cp deploy/.env.example .env
# Everything else (handsets, webhook/trunk credentials, ghost-call
# behaviour) is configured afterwards in the web admin panel.
#
# Generate each password with:  openssl rand -base64 24

# Your DNS name pointing at the VPS — Caddy gets the TLS cert for this.
GHOSTSIP_DOMAIN=ghostsip.example.com

# Admin panel login (Basic Auth on https://<domain>/admin)
GHOSTSIP_ADMIN_USERNAME=admin
GHOSTSIP_ADMIN_PASSWORD=

# Asterisk ARI secret (loopback-only; used by both Asterisk and the
# receiver, so it is set once here and never typed into the panel)
GHOSTSIP_ARI_PASSWORD=
